# ============================================================
# VARIABLES DE ENTORNO — "NUESTRO UNIVERSO"
# ============================================================
# Copia este archivo como ".env.local" y completa los valores.

# --- Supabase (la nube: todo se guarda acá y se ve en los dos) ---
# Obtén estos valores en: Supabase > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Spotify Sync (playlist -> Supabase) ---
# Obtén CLIENT_ID/SECRET en: https://developer.spotify.com/dashboard
# REFRESH_TOKEN: corre "node scripts/get-spotify-token.mjs" (una sola vez)
# PLAYLIST_ID: lo que va después de /playlist/ en la URL de Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_PLAYLIST_ID=
# Opcional: protege el cron (si lo pones, usalo como Bearer al llamar manual)
CRON_SECRET=
# Opcional: para bypass RLS en el cron (si no, usa ANON_KEY con políticas abiertas)
SUPABASE_SERVICE_ROLE_KEY=

# --- Firebase (alternativa opcional, no usada) ---
# Obtén estos valores en: Firebase > Configuración del proyecto
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
